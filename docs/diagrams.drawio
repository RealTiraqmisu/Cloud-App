                <mxCell id="e-counter" edge="1" parent="1" source="t-counters-r0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;fontSize=11;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="t-orders-r1" value="ค่าคิว → queueNumber">
