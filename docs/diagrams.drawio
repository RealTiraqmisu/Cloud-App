                <mxCell id="e-menu" edge="1" parent="1" source="t-items-r0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;dashed=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="t-menu-r0" value="items[].menuId → menuId (อ้างอิงเชิงตรรกะ ไม่มี FK)">
                    <mxGeometry relative="1" x="-0.3555" as="geometry">
                        <mxPoint as="offset"/>
