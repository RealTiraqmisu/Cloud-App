# --- AWS SAM / CloudFormation build output ---
.aws-sam/
packaged.yaml
packaged.yml
*.zip

# --- Secrets & credentials (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
.aws/
credentials
*.credentials

# --- Python (Lambda code) ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node (frontend) ---
# package.json and package-lock.json are NOT ignored: they must be committed
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- draw.io temp / backup files ---
.$*.bkp
.$*.dtmp
*.drawio.bkp

# --- Logs ---
logs/
*.log

# --- Editors & OS ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?
.DS_Store
Thumbs.db
Desktop.ini

